{
  "name": "mailscape",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A public, git-versioned time-series dataset of email authentication posture across the internet's most popular domains.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "build:web": "pnpm --filter @mailscape/web build",
    "clean": "tsc --build tsconfig.build.json --clean && rm -rf packages/*/dist apps/*/dist",
    "typecheck": "tsc --build tsconfig.build.json --force && pnpm typecheck:tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mailscape": "node apps/crawler/dist/cli.js",
    "prepare": "husky || true",
    "typecheck:tests": "pnpm exec tsc -p packages/parsers/test/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4",
    "eslint-plugin-import-x": "^4.6.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
